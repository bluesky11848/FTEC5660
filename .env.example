# Copy to .env and fill in your key. .env is gitignored -- never commit it.
DEEPSEEK_API_KEY=your_key_here

# Optional: override the vision model name (default is the mandated
# deepseek-v4-flash-vision-exp, which DeepSeek still accepts as a legacy alias
# served by the current Flash model).
# HW1_MODEL=deepseek-flash
